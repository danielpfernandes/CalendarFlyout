<Window x:Class="CalendarFlyout.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Agenda Google" Width="392" Height="620"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
 Topmost="True" Background="Transparent" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
 Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="12" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Grid>
    <StackPanel><TextBlock Text="Agenda" FontSize="26" FontWeight="SemiBold" />
     <TextBlock Text="Google Calendar · Hoje + 3 dias" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
    </StackPanel>
    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="9" Click="Hide_Click" ToolTip="Ocultar (Esc)" AutomationProperties.Name="Ocultar agenda" />
   </Grid>
   <Grid x:Name="AgendaContent" Grid.Row="1" Grid.RowSpan="4">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <WrapPanel Grid.Row="0" Margin="0,18,0,10">
    <Button x:Name="ConnectButton" Content="Conectar Google" Click="Connect_Click" Margin="0,0,8,6" />
    <Button x:Name="RefreshButton" Content="Atualizar" Click="Refresh_Click" Margin="0,0,8,6" />
    <Button x:Name="ForgetButton" Content="Esquecer login" Click="Forget_Click" Margin="0,0,0,6" />
    <Button Content="Configurações" Click="Settings_Click" Margin="0,0,0,6" />
   </WrapPanel>
   <TextBlock x:Name="StatusText" Grid.Row="1" Text="Conecte sua conta para ver a agenda." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="DaysList">
     <ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,0,0,18">
       <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,8" />
       <TextBlock Text="Sem eventos" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding EmptyVisibility}" Margin="0,4,0,6" />
       <ItemsControl ItemsSource="{Binding Events}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,6">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
           <Border Background="{DynamicResource AccentBrush}" CornerRadius="1.5" />
           <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CalendarName}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
            <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <TextBlock Grid.Row="3" Text="Agendas selecionadas · Horário local do Windows" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
   </Grid>
   <Grid x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Margin="0,18,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Configurações" FontSize="20" FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" Margin="0,14,0,16">
     <CheckBox x:Name="StartupCheckBox" Content="Iniciar com o Windows" Foreground="{DynamicResource TextBrush}" Click="Startup_Click" />
     <TextBlock x:Name="StartupStatus" Text="Sempre oculto na bandeja ao entrar no Windows." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,10">
     <TextBlock Text="Selecionar agendas" FontWeight="SemiBold" />
     <TextBlock x:Name="SettingsStatus" Text="Conecte sua conta para selecionar agendas." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="CalendarChoices">
      <ItemsControl.ItemTemplate><DataTemplate>
       <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource TextBrush}" HorizontalContentAlignment="Stretch" Padding="3" Margin="0,0,0,9">
        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
       </CheckBox>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
     <Button x:Name="SaveSettingsButton" Content="Salvar agendas" Click="SaveSettings_Click" Margin="0,0,8,0" />
     <Button Content="Voltar" Click="BackSettings_Click" />
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
